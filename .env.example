# Copiar a .env (ignorado por git) y completar. NUNCA versionar valores reales.
# En Cloud Run estas variables las inyecta Secret Manager.

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# true solo en desarrollo local
DEBUG=true

# Postgres local de docker-compose (solo desarrollo)
POSTGRES_DB=verdeazul
POSTGRES_USER=verdeazul
POSTGRES_PASSWORD=

# Con docker compose, DATABASE_URL la arma docker-compose.yml con los valores de arriba.
# Producción (Neon): la cadena de Neon, con ?sslmode=require (va en Secret Manager)
DATABASE_URL=

# Separados por coma. Local: localhost,127.0.0.1  Producción: el dominio *.run.app
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# URL interna del servicio de autorización (verdeazul-autorizador en Cloud Run,
# p. ej. https://verdeazul-autorizador-XXXXX-uc.a.run.app). En local la fija
# docker-compose.yml (http://autorizador:8080), igual que
# AUTORIZADOR_AUTENTICACION=ninguna (sin token OIDC; solo se acepta con DEBUG).
# En producción la autenticación es "oidc" (valor por defecto).
AUTORIZADOR_URL=

# Clave para cifrar los secretos del segundo factor (TOTP y códigos de
# recuperación). Opcional: si está vacía se deriva de SECRET_KEY. En producción,
# un secreto propio en Secret Manager (rotar SECRET_KEY no debe invalidar el 2FA).
MFA_CLAVE_CIFRADO=

# Clave privada Ed25519 para firmar certificados (base64 de 32 bytes). SECRETO.
# Generar con: docker compose exec web python manage.py generar_clave_certificados
# En producción va en Secret Manager (secreto verdeazul-certificado-clave). Sin ella
# no se emiten certificados y aprobar una medición falla (fallo cerrado).
CERTIFICADO_CLAVE_PRIVADA=
# Huellas SHA-256 (hex, separadas por coma) de las claves públicas de Verdeazul: la
# actual y las anteriores. No es secreto. Vacía = solo la clave actual.
CERTIFICADO_CLAVES_CONFIABLES=
