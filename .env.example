# Copiar a .env (ignorado por git) y completar. NUNCA versionar valores reales.
# En Cloud Run estas variables las inyecta Secret Manager.

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# true solo en desarrollo local
DEBUG=true

# Postgres local de docker-compose (solo desarrollo)
POSTGRES_DB=verdeazul
POSTGRES_USER=verdeazul
POSTGRES_PASSWORD=

# Con docker compose, DATABASE_URL la arma docker-compose.yml con los valores de arriba.
# Producción (Neon): la cadena de Neon, con ?sslmode=require (va en Secret Manager)
DATABASE_URL=

# Separados por coma. Local: localhost,127.0.0.1  Producción: el dominio *.run.app
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# URL interna del servicio de autorización (verdeazul-autorizador en Cloud Run,
# p. ej. https://verdeazul-autorizador-XXXXX-uc.a.run.app). Solo producción: en
# local se usa la autorización provisional permisiva con DEBUG=true.
AUTORIZADOR_URL=

# Clave para cifrar los secretos del segundo factor (TOTP y códigos de
# recuperación). Opcional: si está vacía se deriva de SECRET_KEY. En producción,
# un secreto propio en Secret Manager (rotar SECRET_KEY no debe invalidar el 2FA).
MFA_CLAVE_CIFRADO=
