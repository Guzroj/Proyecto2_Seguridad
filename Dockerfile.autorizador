# Imagen del motor de autorización (servicio privado de Cloud Run).
# Servicio HTTP mínimo e independiente de Django: no lleva Django ni psycopg.
FROM python:3.15-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Usuario sin privilegios: el contenedor NO corre como root (mínimo privilegio),
# con el mismo uid que la imagen de Django.
RUN groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --no-create-home app

COPY autorizacion/requirements.txt ./autorizacion/requirements.txt
RUN pip install -r autorizacion/requirements.txt

# Solo el paquete del motor: nada de código de Django ni del dominio.
COPY --chown=app:app autorizacion ./autorizacion

USER app

# Cloud Run define PORT (8080 por defecto).
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn autorizacion.app:app --host 0.0.0.0 --port ${PORT:-8080}"]
